# Staging PostgreSQL + WAL-G (PITR uchun WAL arxivlash va base backup).
FROM postgres:16-bookworm

ARG WALG_VERSION=v3.0.2

RUN apt-get update \
  && apt-get install -y --no-install-recommends curl ca-certificates \
  && curl -fsSL "https://github.com/wal-g/wal-g/releases/download/${WALG_VERSION}/wal-g-pg-ubuntu-20.04-amd64.tar.gz" -o /tmp/wal-g.tar.gz \
  && tar -xzf /tmp/wal-g.tar.gz -C /usr/local/bin \
  && mv /usr/local/bin/wal-g-pg-ubuntu-20.04-amd64 /usr/local/bin/wal-g \
  && chmod 0755 /usr/local/bin/wal-g \
  && rm -f /tmp/wal-g.tar.gz \
  && apt-get purge -y curl \
  && apt-get autoremove -y \
  && rm -rf /var/lib/apt/lists/*

COPY docker/walg/backup.sh /usr/local/bin/backup.sh
RUN chmod 0755 /usr/local/bin/backup.sh
