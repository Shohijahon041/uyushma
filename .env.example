# =============================================================================
# UYUSHMA GPS & FLEET SAAS - PRODUCTION ENVIRONMENT NAMOONASI (.env.example)
# =============================================================================
# Ushbu fayl nusxasini .env nomiga o'tkazing: `cp .env.example .env`
# Diqqat: .env fayli hech qachon git tizimiga qo'shilmasligi shart!
# =============================================================================

# --- UMUMIY SOZLAMALAR ---
NODE_ENV=production
ENVIRONMENT=production
TZ=Asia/Tashkent

# --- 1. XAVFSIZLIK VA AES-256 SHIFRLASH (SECURITY) ---
# Davlat portallari (ijara.soliq.uz, transport.uz, etender.uz) login/parollarini
# va to'lov tokenlarini bazada AES-256-GCM formatida shifrlash uchun 256-bitli kalit:
# Yaratish: `openssl rand -hex 32`
ENCRYPTION_SECRET_KEY=dev-only-encryption-key-0123456789abcdef0123456789abcdef
APP_ENCRYPTION_KEY=dev-only-encryption-key-0123456789abcdef0123456789abcdef

# JWT Avtorizatsiya kaliti (Kamida 32-64 ta belgi)
JWT_SECRET=super-secret-uyushma-jwt-key-2026-production-change-me
JWT_EXPIRATION_DAYS=30
JWT_ACCESS_SECRET=dev-only-change-me-0123456789abcdef0123456789abcdef
JWT_REFRESH_SECRET=dev-only-change-me-fedcba9876543210fedcba9876543210

# --- 2. MA'LUMOTLAR BAZASI VA PGBOUNCER (HIGH-LOAD CONNECTION POOL) ---
# To'g'ridan-to'g'ri PostgreSQL / TimescaleDB ulanishi (admin / migratsiya uchun):
DATABASE_URL=postgresql://postgres:postgres_secure_pass_2026@127.0.0.1:5432/uyushma
# PGBouncer orqali 100 000 ta parallel haydovchi sessiyalari uchun ulanish:
PGBOUNCER_DATABASE_URL=postgresql://postgres:postgres_secure_pass_2026@127.0.0.1:6432/uyushma
PGBOUNCER_PORT=6432

# AsyncPG Pool sozlamalari
DB_POOL_MIN=20
DB_POOL_MAX=100
DB_COMMAND_TIMEOUT=20.0
DB_MAX_INACTIVE_SEC=300.0

# Batch Ingestion (TimescaleDB / Hypertable)
DB_BATCH_SIZE=1000
DB_FLUSH_INTERVAL=0.5
MAX_QUEUE_SIZE=200000

# --- 3. REDIS KESHI VA PUB/SUB ---
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_MAX_CONNECTIONS=200

# --- 4. H02 TCP PROXY GATEWAY (SinoTrack & Mobil Ilova) ---
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=20335
CLIENT_IDLE_TIMEOUT=120.0
MAX_CLIENT_BUFFER=8192

# Davlat GPS Portali (Vazirlik monitoringiga real-time forward qilish)
GOV_GPS_HOST=bm.dtransport.uz
GOV_GPS_PORT=20335
ENABLE_GOV_FORWARD=true

# --- 5. FASTAPI BACKEND & WEBSOCKET DISPATCHER ---
GPS_API_PORT=8020
API_PORT=4000
APP_ORIGIN=https://uyushma.bmbrutto.uz
API_PUBLIC_URL=https://uyushma.bmbrutto.uz/api

# --- 6. ESKIZ.UZ SMS SHLYUZI (OTP AVTORIZATSIYA) ---
ESKIZ_EMAIL=info@uyushma.uz
ESKIZ_PASSWORD=eskiz_secret_password_here

# --- 7. MOLIYA VA TO'LOV TIZIMLARI (CLICK & PAYME) ---
# Click Merchant API
CLICK_SERVICE_ID=12345
CLICK_MERCHANT_ID=54321
CLICK_SECRET_KEY=click_production_secret_key_here

# Payme Merchant API
PAYME_MERCHANT_ID=payme_merchant_id_here
PAYME_KEY=payme_production_secret_key_here
PAYME_CHECKOUT_URL=https://checkout.paycom.uz

# --- 8. TELEGRAM HAYDOVCHI VA DISPETCHER BOTI ---
BOT_TOKEN=123456789:ABCDefGhIJKlmNoPQRsTUVwxyZ_bot_token_here
BOT_API_KEY=bot-internal-secret-key-change-me
BOT_API_URL=http://localhost:4000
BOT_POLLING=true

# --- 9. FAYL VA HUJJATLAR SAQLASH (S3 / MINIO) ---
S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=uyushma-private
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_secure_pass_2026
