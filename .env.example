# ============================================================================
# Uyushmachilar — environment namunasi. Haqiqiy qiymatlarni .env ga yozing.
# .env Git'ga hech qachon qo'shilmaydi.
# Qiymatlarni qo'shtirnoqsiz yozing: Docker env-file va dotenv bir xil o'qiydi.
# ============================================================================
NODE_ENV=development

# --- Ma'lumotlar bazasi -----------------------------------------------------
# Ilova cheklangan huquqli rol bilan ulanadi (RLS amal qilishi shart).
DATABASE_URL=postgresql://uyushma_app:uyushma_app@localhost:5433/uyushma?schema=public
# Migratsiya/seed uchun admin rol. Faqat lokal/staging.
MIGRATE_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/uyushma?schema=public
TEST_DATABASE_URL=postgresql://uyushma_app:uyushma_app@localhost:5433/uyushma_test?schema=public
TEST_MIGRATE_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/uyushma_test?schema=public

# --- API -------------------------------------------------------------------
API_PORT=4000
APP_ORIGIN=http://localhost:3000
API_PUBLIC_URL=http://localhost:4000

# Kamida 32 belgi. Quyida faqat lokal dev uchun namuna.
JWT_ACCESS_SECRET=dev-only-change-me-0123456789abcdef0123456789abcdef
JWT_REFRESH_SECRET=dev-only-change-me-fedcba9876543210fedcba9876543210
# Provayder sirlari va TOTP urug'lari uchun AES-256-GCM kaliti (base64 32 bayt
# yoki 64 belgili hex yoki 32+ belgili matn).
APP_ENCRYPTION_KEY=dev-only-encryption-key-0123456789abcdef
JWT_ISSUER=uyushmachilar
JWT_AUDIENCE=uyushmachilar-api
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# --- Internal / integrations ------------------------------------------------
REDIS_URL=redis://localhost:6380
INTERNAL_API_KEY=dev-only-internal-key-change-me
PAYMENT_WEBHOOK_SECRET=dev-only-webhook-secret-change-me

# --- Observability ----------------------------------------------------------
METRICS_ENABLED=true
# /api/v1/metrics ni himoyalash uchun; bo'sh bo'lsa token talab qilinmaydi.
METRICS_TOKEN=

# --- Bildirishnomalar -------------------------------------------------------
NOTIFICATIONS_ENABLED=true

# --- Email va 2FA -----------------------------------------------------------
REQUIRE_EMAIL_VERIFICATION=false
EMAIL_DRIVER=log
EMAIL_FROM=Uyushmachilar <no-reply@uyushmachilar.uz>
SMTP_PORT=587
SMTP_SECURE=false

# --- To'lov provayderi (Payme) ----------------------------------------------
PAYME_CHECKOUT_URL=https://checkout.paycom.uz
PAYME_TIMEOUT_MINUTES=720

# --- Telegram ---------------------------------------------------------------
BOT_TOKEN=
BOT_API_KEY=dev-only-bot-key-change-me
BOT_API_URL=http://localhost:4000
BOT_POLLING=true

# --- Worker -----------------------------------------------------------------
WORKER_API_URL=http://localhost:4000

# --- Web (Next.js server tomoni) -------------------------------------------
API_INTERNAL_URL=http://localhost:4000
SESSION_COOKIE_SECURE=false
# Production'da albatta false qoldiring (API sxemasi oshkor bo'lmasin).
ENABLE_SWAGGER=true
# Faqat ishonchli reverse proxy ortida true qiling (X-Forwarded-For).
TRUST_PROXY=false

# --- S3-compatible private storage (MinIO lokal) ---------------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=uyushma-private
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
S3_PRESIGN_TTL_SECONDS=300
