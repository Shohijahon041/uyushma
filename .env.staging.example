# ============================================================================
# Staging muhit namunasi. Haqiqiy faylni scripts/staging-bootstrap.mjs yaratadi.
# .env.staging Git'ga tushmaydi.
# ============================================================================
NODE_ENV=staging
DOMAIN=staging.example.uz
ACME_EMAIL=devops@staging.example.uz

# --- Ma'lumotlar bazasi -----------------------------------------------------
POSTGRES_PASSWORD=change-me-postgres-admin
APP_DB_PASSWORD=change-me-app-role
REDIS_PASSWORD=change-me-redis

# --- Xavfsizlik kalitlari (kamida 32 belgi) ---------------------------------
JWT_ACCESS_SECRET=change-me-access-secret-0123456789abcdef
JWT_REFRESH_SECRET=change-me-refresh-secret-0123456789abcdef
APP_ENCRYPTION_KEY=change-me-encryption-key-0123456789abcdef
INTERNAL_API_KEY=change-me-internal-key-0123456789
BOT_API_KEY=change-me-bot-key-0123456789
PAYMENT_WEBHOOK_SECRET=change-me-payment-webhook-secret
METRICS_TOKEN=change-me-metrics-token-0123456789

# --- Telegram ---------------------------------------------------------------
BOT_TOKEN=

# --- S3 / MinIO (ilova fayllari va backuplar) -------------------------------
MINIO_ROOT_USER=uyushma
MINIO_ROOT_PASSWORD=change-me-minio-password
BACKUP_BUCKET=uyushma-backups
S3_BUCKET=uyushma-private
S3_ACCESS_KEY=uyushma
S3_SECRET_KEY=change-me-minio-password
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
S3_PRESIGN_TTL_SECONDS=300

# --- To'lov (Payme) ---------------------------------------------------------
PAYME_CHECKOUT_URL=https://checkout.paycom.uz
PAYME_TIMEOUT_MINUTES=720


# --- Grafana ----------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana-password
